NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Only used when RETAILER_MODE is unset (remove the line, do not leave it empty): true means demo, false means searchapi
DEMO_MODE=true
# demo (fixtures, no keys) | searchapi (live, needs SEARCHAPI_API_KEY)
RETAILER_MODE=demo
ENABLE_DOCS=true
RATE_LIMIT_MAX=30
BRAND_NAME=Findly
# ISO 3166-1 alpha-2 / ISO 4217; used when a search request omits country or currency
DEFAULT_COUNTRY=US
DEFAULT_CURRENCY=USD
DEFAULT_REGION=
# mock | gemini | openai | anthropic (anthropic runs the tool-calling shopping agent)
MODEL_PROVIDER=mock
# Empty uses the provider default (claude-sonnet-5-5, gemini-3.1-flash-lite, gpt-5-mini)
PRIMARY_MODEL=
VISION_MODEL=
FAST_MODEL=
# Server-side secrets; only the key for the selected MODEL_PROVIDER is required. Never ship them to Android.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# searchapi.io key, required when RETAILER_MODE=searchapi
SEARCHAPI_API_KEY=
# Comma list of enabled SearchAPI engines; unknown names are ignored
SEARCHAPI_ENGINES=amazon_search,walmart_search,home_depot_search,bestbuy_search,google_shopping
SEARCHAPI_TIMEOUT_MS=20000
# Response cache TTL in ms; 0 disables caching
SEARCHAPI_CACHE_TTL_MS=300000
# Agent budget: search_products calls per request, offers returned per call
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_RESULTS_PER_CALL=8
RETAILER_CONCURRENCY=2
