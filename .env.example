NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DEMO_MODE=true
# demo | searchapi
RETAILER_MODE=demo
ENABLE_DOCS=true
RATE_LIMIT_MAX=30
BRAND_NAME=Findly
# ISO 3166-1 alpha-2 / ISO 4217; used when a search request omits country or currency
DEFAULT_COUNTRY=US
DEFAULT_CURRENCY=USD
DEFAULT_REGION=
# mock | gemini | openai | anthropic
MODEL_PROVIDER=mock
PRIMARY_MODEL=
VISION_MODEL=
FAST_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SEARCHAPI_API_KEY=
SEARCHAPI_ENGINES=amazon_search,walmart_search,home_depot_search,bestbuy_search,google_shopping
SEARCHAPI_TIMEOUT_MS=20000
SEARCHAPI_CACHE_TTL_MS=300000
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_RESULTS_PER_CALL=8
RETAILER_CONCURRENCY=2
