NODE_ENV=development
PORT=3000
HOST=0.0.0.0
ENABLE_DOCS=true
RATE_LIMIT_MAX=30
BRAND_NAME=Findly
# ISO 3166-1 alpha-2 / ISO 4217; used when a search request omits country or currency
DEFAULT_COUNTRY=US
DEFAULT_CURRENCY=USD
DEFAULT_REGION=
# anthropic runs the tool-calling shopping agent; mock is for tests only
MODEL_PROVIDER=anthropic
# Empty uses claude-sonnet-5-5
PRIMARY_MODEL=
# Server-side secrets, both required. Never ship them to Android.
ANTHROPIC_API_KEY=
SEARCHAPI_API_KEY=
# Comma list of enabled SearchAPI engines; unknown names are ignored
SEARCHAPI_ENGINES=amazon_search,walmart_search,home_depot_search,bestbuy_search,google_shopping
SEARCHAPI_TIMEOUT_MS=20000
# Response cache TTL in ms; 0 disables caching
SEARCHAPI_CACHE_TTL_MS=300000
# Agent budget: search_products calls per request (default 12: a Google Shopping baseline plus each direct retailer, with room to re-query), offers returned per call (default 10)
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_RESULTS_PER_CALL=10
