{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "findly-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production",
    "HOST": "0.0.0.0",
    "PORT": "3000",
    "ENABLE_DOCS": "false",
    "RATE_LIMIT_MAX": "30",
    "MODEL_PROVIDER": "anthropic",
    "PRIMARY_MODEL": "claude-sonnet-5-5",
    "BRAND_NAME": "Findly"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "26081501",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "26081502",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "containers": [
    {
      "name": "findly-api",
      "class_name": "FindlyApiContainer",
      "image": "../docker/api.Dockerfile",
      "image_build_context": "../..",
      "max_instances": 1,
      "instance_type": "basic",
      "constraints": { "regions": ["ENAM"] }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FINDLY_API_CONTAINER",
        "class_name": "FindlyApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FindlyApiContainer"]
    }
  ]
}
